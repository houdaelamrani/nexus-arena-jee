<config
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xmlns='http://www.ehcache.org/v3'
    xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <cache-template name="default-template">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache-template>

    <cache alias="default-query-results-region" uses-template="default-template"/>
    <cache alias="default-update-timestamps-region" uses-template="default-template"/>
    <cache alias="com.nexusarena.model.Membre" uses-template="default-template"/>
    <cache alias="com.nexusarena.model.EspaceArena" uses-template="default-template"/>
</config>
